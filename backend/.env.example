# Application
PORT=3000
NODE_ENV=development
API_PREFIX=v1

# Optional one-time account provisioning when running prisma db seed.
# Leave blank if Super Admin accounts are managed directly in the database.
BOOTSTRAP_SUPER_ADMIN_PHONE=""
BOOTSTRAP_SUPER_ADMIN_NAME=""

# PostgreSQL Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/masjid_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/masjid_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Secrets
JWT_ACCESS_SECRET="masjid_super_secret_jwt_access_key_2026"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="masjid_super_secret_jwt_refresh_key_2026"
JWT_REFRESH_EXPIRES_IN="30d"

# OTP Provider: console | twilio | msg91
OTP_PROVIDER=console
OTP_EXPIRY_SECONDS=300

# Push Notifications (FCM Admin SDK)
FIREBASE_PROJECT_ID="silah-2036a"
# Set this to the Firebase service-account JSON string in your secret manager.
# On Google Cloud, Application Default Credentials can be used instead.
FIREBASE_SERVICE_ACCOUNT_JSON=""
